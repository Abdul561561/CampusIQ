# CampusIQ Environment Configuration Example
# Copy this file to .env and set your actual credentials. DO NOT commit .env to version control.

# OpenRouter API Key (Required for LLM answer generation)
# Get a key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Model Name (Configurable)
# Recommended options:
# - meta-llama/llama-3.3-70b-instruct:free
# - google/gemini-2.5-flash
# - mistralai/mistral-7b-instruct:free
OPENROUTER_MODEL=google/gemini-2.5-flash

# Local Embedding Model (HuggingFace)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# RAG Pipeline Configuration
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K_RETRIEVAL=4

# Application Server Port
PORT=7860
